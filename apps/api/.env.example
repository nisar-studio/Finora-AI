NODE_ENV=development
PORT=4000

# Clerk
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
# Optional: PEM public key for offline (networkless) session verification.
# Only needed for offline dev/test, e.g. the vitest suite (rs256). Leave empty
# in production so tokens are verified against Clerk's rotating JWKS.
CLERK_JWT_KEY=

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/finora_dev

# Gemini (never exposed to the frontend)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# services/ml-service (internal only)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=change-me-in-prod

# CORS - the browser origin that may call this API
CORS_ORIGIN=http://localhost:5173